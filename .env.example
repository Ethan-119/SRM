# ============================================
# SRM 环境变量模板（复制为 .env 并填入真实值；.env 已被 gitignore）
# ============================================

# PostgreSQL（业务库 + pgvector，DB_PASSWORD 与 PGVECTOR_PASSWORD 需一致）
DB_PASSWORD=change_me_db
PGVECTOR_PASSWORD=change_me_db

# Redis
REDIS_PASSWORD=change_me_redis

# Neo4j
NEO4J_PASSWORD=change_me_neo4j

# RabbitMQ
RABBITMQ_PASSWORD=change_me_rabbit

# 阿里云百炼（DashScope）API Key
DASHSCOPE_API_KEY=sk-your-api-key-here

# 首次部署临时开 true（同步图谱 / 灌向量），跑完改回 false
NEO4J_SYNC_ON_STARTUP=false
RAG_INGEST_ON_STARTUP=false
