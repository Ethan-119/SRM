// ============================================
// SRM 供应商知识图谱 - 线上初始化种子数据
// 与 sql/testdata.sql 的 200 家供应商对齐（Supplier.id = srm_supplier.id）
// 约束/索引见 sql/schema.cypher；执行：cypher-shell -f sql/seed.cypher
// ============================================

// ---- 地域 ----
MERGE (r:Region {code: 'north_china'}) SET r.name = '华北', r.riskTag = '关注';
MERGE (r:Region {code: 'east_china'}) SET r.name = '华东', r.riskTag = '稳定';
MERGE (r:Region {code: 'south_china'}) SET r.name = '华南', r.riskTag = '稳定';
MERGE (r:Region {code: 'central_china'}) SET r.name = '华中', r.riskTag = '稳定';
MERGE (r:Region {code: 'southwest'}) SET r.name = '西南', r.riskTag = '稳定';
MERGE (r:Region {code: 'northwest'}) SET r.name = '西北', r.riskTag = '关注';
MERGE (r:Region {code: 'northeast'}) SET r.name = '东北', r.riskTag = '稳定';

// ---- 供应商（200 家） ----
MERGE (s:Supplier {id: 1}) SET s.name = '兰州志高新材料科技有限公司', s.status = '注册', s.creditLevel = 'AA', s.statusCode = 0, s.category = '新材料';
