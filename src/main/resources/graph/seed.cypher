// ---- 地域归属 ----
MATCH (s:Supplier {id: 1}) MATCH (r:Region {code: 'northwest'}) MERGE (s)-[:LOCATED_IN]->(r);
MATCH (s:Supplier {id: 2}) MATCH (r:Region {code: 'southwest'}) MERGE (s)-[:LOCATED_IN]->(r);
MATCH (s:Supplier {id: 3}) MATCH (r:Region {code: 'southwest'}) MERGE (s)-[:LOCATED_IN]->(r);
MATCH (s:Supplier {id: 4}) MATCH (r:Region {code: 'central_china'}) MERGE (s)-[:LOCATED_IN]->(r);
MATCH (s:Supplier {id: 5}) MATCH (r:Region {code: 'northwest'}) MERGE (s)-[:LOCATED_IN]->(r);
